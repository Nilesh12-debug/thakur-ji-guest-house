---
import { property } from '../data/property';
import { Phone, MessageCircle, CalendarCheck } from 'lucide-astro';
---

<div class="sticky-dock" id="stickyDock" aria-label="Quick mobile booking and contact bar">
  <div class="dock-inner">
    <!-- Call Button -->
    <a href={`tel:${property.phone}`} class="dock-btn dock-call" aria-label={`Call ${property.phoneDisplay}`}>
      <Phone size={18} strokeWidth={2.2} />
      <span>Call</span>
    </a>

    <!-- WhatsApp Button -->
    <a 
      href={`https://wa.me/${property.whatsapp}?text=Hello%20Thakur%20Ji%20Guest%20House,%20I%20am%20looking%20for%20room%20availability%20in%20Varanasi.`} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="dock-btn dock-wa" 
      aria-label="Chat with guest house on WhatsApp"
    >
      <MessageCircle size={18} strokeWidth={2.2} />
      <span>WhatsApp</span>
    </a>

    <!-- Primary Book Stay Action -->
    <button class="dock-btn dock-book open-booking-btn" type="button" aria-haspopup="dialog">
      <CalendarCheck size={18} strokeWidth={2.2} />
      <span>Book Your Stay ✦</span>
    </button>
  </div>
</div>

<style>
.sticky-dock {
  display: none;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 850;
  background: rgba(255, 250, 243, 0.96);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-top: 1px solid rgba(185, 137, 63, 0.35);
  box-shadow: 0 -8px 24px rgba(24, 7, 9, 0.12);
  padding: 10px 14px;
  padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
  transform: translateY(110%);
  transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.sticky-dock.visible {
  transform: translateY(0);
}

.dock-inner {
  display: grid;
  grid-template-columns: auto auto 1fr;
  gap: 8px;
  max-width: 500px;
  margin: 0 auto;
  align-items: center;
}

.dock-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  height: 48px;
  border-radius: 14px;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  cursor: pointer;
  border: none;
  transition: transform 0.15s, background-color 0.2s;
  -webkit-tap-highlight-color: transparent;
}

.dock-btn:active {
  transform: scale(0.97);
}

.dock-call {
  padding: 0 14px;
  background: rgba(87, 16, 25, 0.08);
  color: var(--wine);
  border: 1px solid rgba(87, 16, 25, 0.18);
}

.dock-wa {
  padding: 0 14px;
  background: #25d366;
  color: #ffffff;
  box-shadow: 0 4px 12px rgba(37, 211, 102, 0.25);
}

.dock-book {
  padding: 0 16px;
  background: linear-gradient(135deg, var(--wine), var(--wine2));
  color: #ffffff;
  box-shadow: 0 4px 16px rgba(87, 16, 25, 0.32);
}

/* Only display on viewports below 900px */
@media (max-width: 900px) {
  .sticky-dock {
    display: block;
  }
}
</style>

<script>
  // Show sticky dock once user scrolls past hero (approx 350px)
  const dock = document.getElementById('stickyDock');
  let isVisible = false;

  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    if (y > 320 && !isVisible) {
      isVisible = true;
      dock?.classList.add('visible');
    } else if (y <= 320 && isVisible) {
      isVisible = false;
      dock?.classList.remove('visible');
    }
  }, { passive: true });
</script>
