---
import type { Room } from '../data/property';
import { Users, Wind, Wifi, ArrowRight } from 'lucide-astro';

interface Props {
  room: Room;
  index: number;
}

const { room, index } = Astro.props;
---

<article class="room-card reveal" data-room-id={room.id}>
  <picture class="room-media">
    <source srcset={room.imageWebp} type="image/webp" />
    <img 
      src={room.image} 
      alt={`${room.name} at Thakur Ji Guest House Varanasi`} 
      loading="lazy" 
      width="1418" 
      height="1064"
    />
  </picture>

  <div class="room-gradient"></div>

  <div class="room-info">
    <div class="room-header-row">
      <span class="room-tagline">{room.sublabel}</span>
      {room.badge && <span class="room-badge">{room.badge}</span>}
    </div>

    <h3 class="room-name">{room.name}</h3>
    
    <!-- Quick feature pill badges -->
    <div class="room-meta">
      <span class="meta-tag">
        <Users size={12} />
        <span>{room.capacity}</span>
      </span>
      <span class="meta-tag">
        <Wind size={12} />
        <span>AC</span>
      </span>
      <span class="meta-tag">
        <Wifi size={12} />
        <span>Wi‑Fi</span>
      </span>
    </div>

    {room.description && (
      <p class="room-desc">{room.description}</p>
    )}

    <!-- Editorial Interaction: Explore Room -->
    <div class="room-action-row">
      <button 
        class="room-explore-link open-room-detail-trigger" 
        type="button" 
        data-room-id={room.id}
        aria-label={`Explore ${room.name}`}
      >
        <span>Explore Room</span>
        <ArrowRight size={15} />
      </button>
    </div>
  </div>

  <button 
    class="room-arrow-desktop open-room-detail-trigger" 
    type="button" 
    data-room-id={room.id}
    aria-label={`Explore ${room.name}`}
  >
    →
  </button>
</article>

<style>
.room-card {
  position: relative;
  min-height: 520px;
  border-radius: 26px;
  overflow: hidden;
  box-shadow: 0 24px 60px rgba(47, 23, 16, 0.12);
  background: #20080a;
  isolation: isolate;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  scroll-snap-align: start;
  transition: transform 0.35s ease, box-shadow 0.35s ease;
}

.room-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 35px 80px rgba(47, 23, 16, 0.2);
}

.room-media {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.room-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.room-card:hover .room-media img {
  transform: scale(1.05);
}

.room-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 35%, rgba(20, 6, 7, 0.75) 68%, rgba(20, 6, 7, 0.95) 100%);
  z-index: 2;
  pointer-events: none;
}

.room-info {
  position: relative;
  z-index: 3;
  padding: 28px 24px 24px;
  color: #fff8eb;
}

.room-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}

.room-tagline {
  font-size: 9px;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: #e5c171;
  font-weight: 700;
}

.room-badge {
  background: rgba(185, 137, 63, 0.35);
  border: 1px solid rgba(228, 191, 112, 0.45);
  color: #f7deb0;
  font-size: 8.5px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  font-weight: 800;
  padding: 3px 8px;
  border-radius: 99px;
}

.room-name {
  font: 600 34px / 1.1 var(--font-serif);
  margin: 6px 0 10px;
  color: #ffffff;
  letter-spacing: -0.5px;
}

.room-meta {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}

.meta-tag {
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.18);
  padding: 4px 10px;
  border-radius: 99px;
  font-size: 10px;
  font-weight: 600;
  color: #f4e8d8;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  cursor: default;
}

.meta-tag:hover {
  background: rgba(223, 186, 105, 0.22);
  border-color: rgba(223, 186, 105, 0.55);
  color: #fffaf0;
  transform: translateY(-2px);
}

.meta-tag :global(svg) {
  color: #e5c171;
  transition: color 0.3s ease, transform 0.3s ease, filter 0.3s ease;
}

.meta-tag:hover :global(svg) {
  color: #ffd880;
  transform: scale(1.2);
  filter: drop-shadow(0 0 6px rgba(223, 186, 105, 0.8));
}

.room-desc {
  margin: 8px 0 16px;
  font-size: 12px;
  line-height: 1.65;
  color: #f2e6d2;
  max-width: 90%;
}

.room-action-row {
  display: flex;
  align-items: center;
  padding-top: 4px;
}

.room-explore-link {
  background: transparent;
  border: none;
  color: #dfba69;
  font-size: 13.5px;
  font-weight: 700;
  letter-spacing: 0.5px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 0;
  transition: color 0.25s, transform 0.25s, filter 0.25s;
  -webkit-tap-highlight-color: transparent;
}

.room-explore-link:hover {
  color: #ffffff;
  transform: translateX(5px);
  filter: drop-shadow(0 0 8px rgba(223, 186, 105, 0.7));
}

.room-explore-link:active {
  transform: scale(0.96);
}

.room-arrow-desktop {
  position: absolute;
  right: 20px;
  top: 20px;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255, 228, 177, 0.35);
  background: rgba(24, 7, 9, 0.45);
  backdrop-filter: blur(8px);
  color: #f7deb0;
  z-index: 4;
  font-size: 17px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.room-card:hover .room-arrow-desktop {
  background: #dfba69;
  color: #21090b;
  border-color: #dfba69;
  transform: scale(1.06);
}

@media (max-width: 900px) {
  .room-arrow-desktop {
    display: none;
  }
  .room-card {
    min-height: 480px;
    border-radius: 24px;
  }
  .room-info {
    padding: 20px 18px;
  }
  .room-name {
    font-size: 28px;
  }
  .room-desc {
    max-width: 100%;
    font-size: 11.5px;
  }
}
</style>
