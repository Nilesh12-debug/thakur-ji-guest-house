---
import { property } from '../data/property';
import { Phone, MessageCircle, MapPin, Calendar, Menu, X } from 'lucide-astro';
---

<header class="nav-wrapper">
  <nav class="nav" id="mainNav" aria-label="Main Navigation">
    <!-- Brand Identity -->
    <a href="#home" class="brand" aria-label="Thakur Ji Guest House Home">
      <svg class="brand-icon" viewBox="0 0 40 48" aria-hidden="true" focusable="false">
        <path d="M5 43h30M10 43V25h20v18M14 25V15h12v10M18 15V7h4v8M20 3v4M9 25l11-9 11 9M16 43V32h8v11" />
      </svg>
      <div class="brand-text">
        <span class="brand-title">Thakur Ji</span>
        <span class="brand-subtitle">GUEST HOUSE · VARANASI</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <div class="links" role="menubar">
      <a href="#story" role="menuitem">Why Stay</a>
      <a href="#rooms" role="menuitem">Rooms</a>
      <a href="#amenities" role="menuitem">What You Get</a>
      <a href="#gallery" role="menuitem">Gallery</a>
      <a href="#location" role="menuitem">Experience Kashi</a>
    </div>

    <!-- Desktop & Mobile Right Actions -->
    <div class="nav-right">
      <a href={`tel:${property.phone}`} class="nav-mini" aria-label={`Call ${property.phoneDisplay}`}>
        <Phone size={13} strokeWidth={2.2} />
        <span>Call / WhatsApp</span>
      </a>

      <!-- Prominent Book Button (visible on mobile and desktop) -->
      <button class="btn primary nav-book-btn open-booking-btn" type="button" aria-haspopup="dialog">
        <span>Book</span>
        <span class="desktop-only-text"> your stay ✦</span>
      </button>

      <!-- Mobile Hamburger Toggle -->
      <button 
        class="menu-toggle" 
        id="menuToggle" 
        type="button"
        aria-label="Toggle navigation menu" 
        aria-expanded="false"
        aria-controls="mobileDrawer"
      >
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
        <span class="bar bar-3"></span>
      </button>
    </div>
  </nav>

  <!-- Premium Mobile Drawer Modal -->
  <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
    <div class="mobile-drawer-inner">
      <div class="drawer-header">
        <div class="drawer-brand">
          <span class="drawer-title">Thakur Ji Guest House</span>
          <span class="drawer-city">Varanasi, Uttar Pradesh</span>
        </div>
        <button type="button" class="drawer-close" id="drawerClose" aria-label="Close menu">
          ✕
        </button>
      </div>

      <div class="mobile-links" role="menu">
        <a href="#home" class="mobile-link" role="menuitem">
          <span>00</span>
          <b>Home · Welcome</b>
        </a>
        <a href="#story" class="mobile-link" role="menuitem">
          <span>01</span>
          <b>Why Stay · Arrival Story</b>
        </a>
        <a href="#why-thakur-ji" class="mobile-link" role="menuitem">
          <span>02</span>
          <b>Comfort Promise · Why Thakur Ji</b>
        </a>
        <a href="#rooms" class="mobile-link" role="menuitem">
          <span>03</span>
          <b>Rooms & Family Suites</b>
        </a>
        <a href="#amenities" class="mobile-link" role="menuitem">
          <span>04</span>
          <b>Verified Amenities</b>
        </a>
        <a href="#gallery" class="mobile-link" role="menuitem">
          <span>✦</span>
          <b>Property Photo Gallery</b>
        </a>
        <a href="#location" class="mobile-link" role="menuitem">
          <span>05</span>
          <b>Experience Kashi & Reviews</b>
        </a>
      </div>

      <div class="drawer-divider"></div>

      <!-- Mobile Fast-Action Conversion Buttons -->
      <div class="mobile-actions">
        <button class="btn primary open-booking-btn w-full drawer-cta-btn" type="button">
          <Calendar size={18} strokeWidth={2} />
          <span>Book Your Stay ✦</span>
        </button>

        <a 
          href={`https://wa.me/${property.whatsapp}?text=Hello%20Thakur%20Ji%20Guest%20House,%20I%20am%20enquiring%20about%20room%20availability%20in%20Varanasi.`} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn ghost mobile-wa-btn w-full"
        >
          <MessageCircle size={18} strokeWidth={2} />
          <span>WhatsApp Enquiry</span>
        </a>

        <a href={`tel:${property.phone}`} class="btn outline-dark w-full mobile-call-btn">
          <Phone size={18} strokeWidth={2} />
          <span>Call Host: {property.phoneDisplay}</span>
        </a>
      </div>

      <div class="drawer-footer-note">
        <a href={property.mapUrl || "https://maps.google.com/?q=Thakur+Ji+Guest+House+Varanasi"} target="_blank" rel="noopener noreferrer" class="drawer-map-link">
          <MapPin size={14} />
          <span>Open location in Google Maps ↗</span>
        </a>
        <div class="drawer-blessing">अतिथि देवो भवः · हर हर महादेव</div>
      </div>

      <!-- Faint Ghat Silhouette at Drawer Bottom -->
      <svg class="drawer-ghat-svg" viewBox="0 0 700 180" aria-hidden="true" focusable="false">
        <path d="M0 160h700M30 150v-60h45v60M90 150v-90h65v90M180 150v-70h50v70M250 150v-110h80v110M350 150v-75h60v75M440 150v-95h70v95M540 150v-65h50v65M620 150v-80h55v80" />
      </svg>
    </div>
  </div>
</header>

<style>
.nav-wrapper {
  position: fixed;
  top: 18px;
  left: 0;
  right: 0;
  z-index: 900;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.nav {
  pointer-events: auto;
  width: min(1420px, 94vw);
  height: 72px;
  padding: 0 16px 0 24px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 20px;
  border: 1px solid rgba(145, 101, 65, 0.16);
  border-radius: 22px;
  background: rgba(255, 250, 243, 0.84);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  box-shadow: 0 18px 44px rgba(24, 10, 7, 0.08);
  transition: all 0.35s ease;
}

.nav.scrolled {
  height: 64px;
  background: rgba(255, 250, 243, 0.96);
  box-shadow: 0 22px 50px rgba(24, 10, 7, 0.14);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}

.brand-icon {
  width: 32px;
  height: 38px;
  stroke: var(--wine);
  fill: none;
  stroke-width: 1.4;
  flex-shrink: 0;
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: 26px;
  line-height: 1;
  color: var(--wine);
  letter-spacing: -0.5px;
}

.brand-subtitle {
  font-size: 7.5px;
  letter-spacing: 3.2px;
  text-transform: uppercase;
  color: #896655;
  margin-top: 3px;
  font-weight: 700;
}

.links {
  display: flex;
  gap: 26px;
  font-size: 12px;
  font-weight: 700;
}

.links a {
  position: relative;
  padding: 16px 0;
  color: #49332c;
  transition: color 0.25s;
}

.links a::after {
  content: "";
  position: absolute;
  left: 0;
  right: 100%;
  bottom: 8px;
  height: 2px;
  background: var(--gold);
  transition: right 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.links a:hover {
  color: var(--wine);
}

.links a:hover::after {
  right: 0;
}

.nav-right {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12px;
}

.nav-mini {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11.5px;
  font-weight: 700;
  color: #66463c;
  padding: 8px 12px;
  border-radius: 999px;
  transition: background 0.2s;
}

.nav-mini:hover {
  background: rgba(102, 70, 60, 0.08);
  color: var(--wine);
}

.menu-toggle {
  display: none;
  background: rgba(87, 16, 25, 0.06);
  border: 1px solid rgba(87, 16, 25, 0.14);
  cursor: pointer;
  padding: 0;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  z-index: 920;
}

.menu-toggle .bar {
  display: block;
  width: 20px;
  height: 2px;
  background: var(--wine);
  border-radius: 2px;
  transition: transform 0.25s, opacity 0.25s;
}

.menu-toggle.active .bar-1 {
  transform: translateY(7px) rotate(45deg);
}

.menu-toggle.active .bar-2 {
  opacity: 0;
}

.menu-toggle.active .bar-3 {
  transform: translateY(-7px) rotate(-45deg);
}

/* Mobile Drawer Fullscreen Overlay */
.mobile-drawer {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(18, 5, 6, 0.65);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
  pointer-events: none;
}

.mobile-drawer.active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.mobile-drawer-inner {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: min(400px, 90vw);
  background: #fffaf3;
  padding: 24px 20px 32px;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  box-shadow: -10px 0 40px rgba(0, 0, 0, 0.3);
  transform: translateX(100%);
  transition: transform 0.32s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.mobile-drawer.active .mobile-drawer-inner {
  transform: translateX(0);
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16px;
  border-bottom: 1px solid rgba(185, 137, 63, 0.2);
}

.drawer-title {
  display: block;
  font: 700 20px / 1.1 var(--font-serif);
  color: var(--wine);
}

.drawer-city {
  display: block;
  font-size: 8.5px;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: #8c6e5e;
  margin-top: 3px;
  font-weight: 700;
}

.drawer-close {
  background: rgba(87, 16, 25, 0.08);
  border: none;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  color: var(--wine);
  font-size: 16px;
  display: grid;
  place-items: center;
  cursor: pointer;
}

.mobile-links {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 16px;
}

.mobile-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-radius: 12px;
  text-decoration: none;
  transition: background 0.2s;
  min-height: 48px;
}

.mobile-link:hover,
.mobile-link:active {
  background: rgba(87, 16, 25, 0.06);
}

.mobile-link span {
  font-size: 11px;
  font-weight: 800;
  color: #b9893f;
  width: 20px;
}

.mobile-link b {
  font: 600 17px var(--font-serif);
  color: #3b221a;
}

.drawer-divider {
  height: 1px;
  background: rgba(185, 137, 63, 0.18);
  margin: 16px 0;
}

.mobile-actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.drawer-cta-btn {
  height: 50px;
  font-size: 13px;
  border-radius: 14px;
}

.mobile-wa-btn {
  height: 48px;
  background: #25d366;
  color: #ffffff;
  border: none;
  border-radius: 14px;
  font-size: 13px;
  font-weight: 700;
}

.mobile-call-btn {
  height: 48px;
  border-radius: 14px;
  font-size: 13px;
}

.w-full {
  width: 100%;
}

.drawer-footer-note {
  margin-top: 24px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 11.5px;
  color: #7a6358;
}

.drawer-map-link {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #9c6c2e;
  font-weight: 700;
}

.drawer-blessing {
  font-family: var(--font-devanagari);
  font-size: 13px;
  color: #b28342;
}

.drawer-ghat-svg {
  width: 100%;
  height: 40px;
  opacity: 0.12;
  margin-top: auto;
  pointer-events: none;
}

.drawer-ghat-svg path {
  stroke: #7c1921;
  fill: none;
  stroke-width: 1.5;
}

@media (max-width: 1100px) {
  .links {
    display: none;
  }
  .nav {
    grid-template-columns: 1fr auto;
  }
}

/* Mobile viewport adjustments: 360px - 768px */
@media (max-width: 768px) {
  .nav-wrapper {
    top: 10px;
  }
  .nav {
    height: 60px;
    padding: 0 10px 0 16px;
    border-radius: 18px;
    width: calc(100vw - 20px);
  }
  .brand-title {
    font-size: 21px;
  }
  .brand-subtitle {
    display: none;
  }
  .nav-mini {
    display: none;
  }
  .desktop-only-text {
    display: none;
  }
  .nav-book-btn {
    padding: 10px 16px;
    height: 40px;
    font-size: 11.5px;
  }
  .menu-toggle {
    display: flex;
  }
  .mobile-drawer {
    display: block;
  }
}
</style>

<script>
  // Mobile drawer controls with body scroll lock
  const nav = document.getElementById('mainNav');
  const menuToggle = document.getElementById('menuToggle');
  const mobileDrawer = document.getElementById('mobileDrawer');
  const drawerClose = document.getElementById('drawerClose');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 30) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }
  }, { passive: true });

  function openDrawer() {
    mobileDrawer?.classList.add('active');
    menuToggle?.setAttribute('aria-expanded', 'true');
    menuToggle?.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    mobileDrawer?.classList.remove('active');
    menuToggle?.setAttribute('aria-expanded', 'false');
    menuToggle?.classList.remove('active');
    document.body.style.overflow = '';
  }

  menuToggle?.addEventListener('click', () => {
    if (mobileDrawer?.classList.contains('active')) {
      closeDrawer();
    } else {
      openDrawer();
    }
  });

  drawerClose?.addEventListener('click', closeDrawer);
  mobileDrawer?.addEventListener('click', (e) => {
    if (e.target === mobileDrawer) closeDrawer();
  });

  mobileLinks.forEach(link => {
    link.addEventListener('click', closeDrawer);
  });
</script>
