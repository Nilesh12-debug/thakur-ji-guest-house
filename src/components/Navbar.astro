---
import { property } from '../data/property';
import { Phone, MessageCircle } from 'lucide-astro';
---

<header class="nav-wrapper">
  <nav class="nav" id="mainNav" aria-label="Main Navigation">
    <a href="#home" class="brand" aria-label="Thakur Ji Guest House Home">
      <svg class="brand-icon" viewBox="0 0 40 48" aria-hidden="true" focusable="false">
        <path d="M5 43h30M10 43V25h20v18M14 25V15h12v10M18 15V7h4v8M20 3v4M9 25l11-9 11 9M16 43V32h8v11" />
      </svg>
      <div class="brand-text">
        <span class="brand-title">Thakur Ji</span>
        <span class="brand-subtitle">GUEST HOUSE · VARANASI</span>
      </div>
    </a>

    <div class="links" role="menubar">
      <a href="#story" role="menuitem">Why Stay</a>
      <a href="#rooms" role="menuitem">Rooms</a>
      <a href="#amenities" role="menuitem">What You Get</a>
      <a href="#gallery" role="menuitem">Gallery</a>
      <a href="#location" role="menuitem">Experience Kashi</a>
    </div>

    <div class="nav-right">
      <a href={`tel:${property.phone}`} class="nav-mini" aria-label={`Call ${property.phoneDisplay}`}>
        <Phone size={13} strokeWidth={2.2} />
        <span>Call / WhatsApp</span>
      </a>
      <button class="btn primary open-booking-btn" type="button" aria-haspopup="dialog">
        Book your stay ✦
      </button>
      <button class="menu-toggle" id="menuToggle" aria-label="Toggle navigation menu" aria-expanded="false">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
    <div class="mobile-drawer-inner">
      <div class="mobile-links">
        <a href="#home" class="mobile-link">Home</a>
        <a href="#story" class="mobile-link">Why Stay (Chapters 01–02)</a>
        <a href="#rooms" class="mobile-link">Rooms & Suites</a>
        <a href="#amenities" class="mobile-link">Guest Amenities</a>
        <a href="#gallery" class="mobile-link">Property Gallery</a>
        <a href="#location" class="mobile-link">Experience Kashi</a>
      </div>
      <div class="mobile-actions">
        <a href={`https://wa.me/${property.whatsapp}?text=Hello%20Thakur%20Ji%20Guest%20House,%20I%20would%20like%20to%20enquire%20about%20a%20stay.`} target="_blank" rel="noopener noreferrer" class="btn ghost mobile-wa-btn">
          <MessageCircle size={16} strokeWidth={2} />
          <span>Chat on WhatsApp</span>
        </a>
        <button class="btn primary open-booking-btn w-full" type="button">
          Book your stay ✦
        </button>
        <div class="mobile-contact-info">
          <span>📞 {property.phoneDisplay}</span>
          <span>📍 {property.address}</span>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
.nav-wrapper {
  position: fixed;
  top: 18px;
  left: 0;
  right: 0;
  z-index: 900;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.nav {
  pointer-events: auto;
  width: min(1420px, 94vw);
  height: 72px;
  padding: 0 16px 0 24px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 20px;
  border: 1px solid rgba(145, 101, 65, 0.16);
  border-radius: 22px;
  background: rgba(255, 250, 243, 0.82);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  box-shadow: 0 18px 44px rgba(24, 10, 7, 0.08);
  transition: all 0.35s ease;
}

.nav.scrolled {
  height: 64px;
  background: rgba(255, 250, 243, 0.94);
  box-shadow: 0 22px 50px rgba(24, 10, 7, 0.14);
  border-color: rgba(145, 101, 65, 0.22);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}

.brand-icon {
  width: 34px;
  height: 40px;
  stroke: var(--wine);
  fill: none;
  stroke-width: 1.4;
  flex-shrink: 0;
  transition: transform 0.3s ease;
}

.brand:hover .brand-icon {
  transform: scale(1.05);
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: 26px;
  line-height: 1;
  color: var(--wine);
  letter-spacing: -0.5px;
}

.brand-subtitle {
  font-size: 7.5px;
  letter-spacing: 3.2px;
  text-transform: uppercase;
  color: #896655;
  margin-top: 3px;
  font-weight: 700;
}

.links {
  display: flex;
  gap: 28px;
  font-size: 12px;
  font-weight: 700;
}

.links a {
  position: relative;
  padding: 16px 0;
  color: #49332c;
  transition: color 0.25s;
}

.links a::after {
  content: "";
  position: absolute;
  left: 0;
  right: 100%;
  bottom: 8px;
  height: 2px;
  background: var(--gold);
  transition: right 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.links a:hover {
  color: var(--wine);
}

.links a:hover::after {
  right: 0;
}

.nav-right {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 14px;
}

.nav-mini {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 11.5px;
  font-weight: 700;
  color: #66463c;
  padding: 8px 12px;
  border-radius: 999px;
  transition: background 0.2s;
}

.nav-mini:hover {
  background: rgba(102, 70, 60, 0.08);
  color: var(--wine);
}

.nav-mini-pulse {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #25d366;
  box-shadow: 0 0 0 2px rgba(37, 211, 102, 0.3);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5);
  }
  70% {
    box-shadow: 0 0 0 6px rgba(37, 211, 102, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
  }
}

.menu-toggle {
  display: none;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 8px;
  flex-direction: column;
  gap: 5px;
  z-index: 920;
}

.menu-toggle .bar {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--wine);
  border-radius: 2px;
  transition: transform 0.3s, opacity 0.3s;
}

.menu-toggle.active .bar:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}

.menu-toggle.active .bar:nth-child(2) {
  opacity: 0;
}

.menu-toggle.active .bar:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg);
}

/* Mobile Drawer */
.mobile-drawer {
  display: none;
  position: fixed;
  top: 86px;
  left: 3vw;
  right: 3vw;
  background: rgba(255, 250, 243, 0.98);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(185, 137, 63, 0.3);
  border-radius: 24px;
  padding: 24px;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.2);
  transform: translateY(-15px);
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  pointer-events: none;
}

.mobile-drawer.active {
  transform: translateY(0);
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.mobile-links {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding-bottom: 20px;
  border-bottom: 1px solid rgba(102, 66, 43, 0.12);
}

.mobile-link {
  font-family: var(--font-serif);
  font-size: 20px;
  font-weight: 600;
  color: #44241d;
  transition: color 0.2s;
}

.mobile-link:hover {
  color: var(--wine);
}

.mobile-actions {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 18px;
}

.mobile-wa-btn {
  background: #25090c;
  color: #fff;
  border-color: rgba(228, 191, 112, 0.4);
}

.w-full {
  width: 100%;
}

.mobile-contact-info {
  margin-top: 8px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 11px;
  color: #7a6358;
}

@media (max-width: 1100px) {
  .links {
    display: none;
  }
  .nav {
    grid-template-columns: 1fr auto;
  }
}

@media (max-width: 680px) {
  .nav-wrapper {
    top: 10px;
  }
  .nav {
    height: 62px;
    padding: 0 14px 0 18px;
    border-radius: 18px;
  }
  .brand-title {
    font-size: 22px;
  }
  .brand-subtitle {
    display: none;
  }
  .nav-mini {
    display: none;
  }
  .menu-toggle {
    display: flex;
  }
  .mobile-drawer {
    display: block;
    top: 78px;
  }
}
</style>

<script>
  // Navigation scroll styling & mobile drawer toggling
  const nav = document.getElementById('mainNav');
  const menuToggle = document.getElementById('menuToggle');
  const mobileDrawer = document.getElementById('mobileDrawer');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }
  }, { passive: true });

  menuToggle?.addEventListener('click', () => {
    const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
    menuToggle.setAttribute('aria-expanded', (!isExpanded).toString());
    menuToggle.classList.toggle('active');
    mobileDrawer?.classList.toggle('active');
    if (mobileDrawer) {
      mobileDrawer.setAttribute('aria-hidden', isExpanded.toString());
    }
  });

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      menuToggle?.classList.remove('active');
      menuToggle?.setAttribute('aria-expanded', 'false');
      mobileDrawer?.classList.remove('active');
      mobileDrawer?.setAttribute('aria-hidden', 'true');
    });
  });
</script>
