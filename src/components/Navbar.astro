---
import { property } from '../data/property';
import { Phone, MessageCircle, Navigation } from 'lucide-astro';
---

<header class="nav-wrapper">
  <nav class="nav" id="mainNav" aria-label="Main Navigation">
    <!-- Brand Identity -->
    <a href="#home" class="brand" aria-label="Thakur Ji Guest House Home">
      <svg class="brand-icon" viewBox="0 0 40 48" aria-hidden="true" focusable="false">
        <path d="M5 43h30M10 43V25h20v18M14 25V15h12v10M18 15V7h4v8M20 3v4M9 25l11-9 11 9M16 43V32h8v11" />
      </svg>
      <div class="brand-text">
        <span class="brand-title">Thakur Ji</span>
        <span class="brand-subtitle">GUEST HOUSE · VARANASI</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <div class="links" role="menubar">
      <a href="#story" role="menuitem">Why Stay</a>
      <a href="#rooms" role="menuitem">Rooms</a>
      <a href="#gallery" role="menuitem">Gallery</a>
      <a href="#location" role="menuitem">Experience Kashi</a>
      <a href="#location" role="menuitem">Location</a>
      <a href="#footer" role="menuitem">Contact</a>
    </div>

    <!-- Right: Mobile Menu Toggle only (Zero sales CTA in Navbar) -->
    <div class="nav-right">

      <!-- Mobile Hamburger Toggle -->
      <button 
        class="menu-toggle" 
        id="menuToggle" 
        type="button"
        aria-label="Toggle navigation menu" 
        aria-expanded="false"
        aria-controls="mobileDrawer"
      >
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
        <span class="bar bar-3"></span>
      </button>
    </div>
  </nav>

  <!-- Clean, Non-Pushy Mobile Drawer -->
  <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
    <div class="mobile-drawer-inner">
      <div class="drawer-header">
        <div class="drawer-brand">
          <span class="drawer-title">Thakur Ji Guest House</span>
          <span class="drawer-city">Varanasi · Uttar Pradesh</span>
        </div>
        <button type="button" class="drawer-close" id="drawerClose" aria-label="Close menu">
          ✕
        </button>
      </div>

      <div class="mobile-links" role="menu">
        <a href="#home" class="mobile-link" role="menuitem">
          <span>00</span>
          <b>Home</b>
        </a>
        <a href="#story" class="mobile-link" role="menuitem">
          <span>01</span>
          <b>Why Stay · Arrival Story</b>
        </a>
        <a href="#why-thakur-ji" class="mobile-link" role="menuitem">
          <span>02</span>
          <b>Why Thakur Ji</b>
        </a>
        <a href="#rooms" class="mobile-link" role="menuitem">
          <span>03</span>
          <b>Rooms & Suites</b>
        </a>
        <a href="#amenities" class="mobile-link" role="menuitem">
          <span>04</span>
          <b>Amenities</b>
        </a>
        <a href="#gallery" class="mobile-link" role="menuitem">
          <span>✦</span>
          <b>Photo Gallery</b>
        </a>
        <a href="#location" class="mobile-link" role="menuitem">
          <span>05</span>
          <b>Experience Kashi & Location</b>
        </a>
      </div>

      <div class="drawer-divider"></div>

      <!-- Plain, Helpful Contact Links (No shouting sales CTAs) -->
      <div class="drawer-contact-block">
        <span class="drawer-contact-title">Contact & Location</span>
        <div class="drawer-contact-items">
          <a href={`tel:${property.phone}`} class="drawer-contact-item">
            <Phone size={15} />
            <span>Call: {property.phoneDisplay}</span>
          </a>
          <a 
            href={`https://wa.me/${property.whatsapp}?text=Hello%20Thakur%20Ji%20Guest%20House`} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="drawer-contact-item"
          >
            <MessageCircle size={15} />
            <span>WhatsApp: Message us</span>
          </a>
          <a 
            href={property.mapUrl || "https://maps.google.com/?q=Thakur+Ji+Guest+House+Varanasi"} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="drawer-contact-item"
          >
            <Navigation size={15} />
            <span>Google Maps: Find property ↗</span>
          </a>
        </div>
      </div>

      <div class="drawer-footer-note">
        <div class="drawer-blessing">अतिथि देवो भवः · हर हर महादेव</div>
      </div>
    </div>
  </div>
</header>

<style>
.nav-wrapper {
  position: fixed;
  top: 18px;
  left: 0;
  right: 0;
  z-index: 900;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.nav {
  pointer-events: auto;
  width: min(1380px, 94vw);
  height: 68px;
  padding: 0 28px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1px solid rgba(145, 101, 65, 0.16);
  border-radius: 20px;
  background: rgba(255, 250, 243, 0.85);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  box-shadow: 0 16px 40px rgba(24, 10, 7, 0.06);
  transition: all 0.35s ease;
}

.nav.scrolled {
  height: 62px;
  background: rgba(255, 250, 243, 0.96);
  box-shadow: 0 20px 48px rgba(24, 10, 7, 0.1);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}

.brand-icon {
  width: 30px;
  height: 36px;
  stroke: var(--wine);
  fill: none;
  stroke-width: 1.4;
  flex-shrink: 0;
  transition: stroke 0.4s ease, transform 0.4s ease, filter 0.4s ease;
}

.brand:hover .brand-icon {
  stroke: #b9893f;
  transform: scale(1.1) translateY(-1px);
  filter: drop-shadow(0 0 8px rgba(185, 137, 63, 0.6));
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: 24px;
  line-height: 1;
  color: var(--wine);
  letter-spacing: -0.5px;
  transition: color 0.3s ease;
}

.brand:hover .brand-title {
  color: #7b1722;
}

.brand-subtitle {
  font-size: 7.5px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: #896655;
  margin-top: 3px;
  font-weight: 700;
}

.links {
  display: flex;
  justify-content: center;
  gap: 28px;
  font-size: 12.5px;
  font-weight: 600;
}

.links a {
  position: relative;
  padding: 12px 0;
  color: #49332c;
  transition: color 0.25s;
}

.links a::after {
  content: "";
  position: absolute;
  left: 0;
  right: 100%;
  bottom: 4px;
  height: 1.5px;
  background: var(--gold);
  transition: right 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.links a:hover {
  color: var(--wine);
}

.links a:hover::after {
  right: 0;
}

.nav-right {
  display: flex;
  align-items: center;
}

.menu-toggle {
  display: none;
  background: rgba(87, 16, 25, 0.05);
  border: 1px solid rgba(87, 16, 25, 0.12);
  cursor: pointer;
  padding: 0;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  z-index: 920;
  transition: background-color 0.25s, transform 0.2s;
}

.menu-toggle:active {
  transform: scale(0.92);
}

.menu-toggle .bar {
  display: block;
  width: 20px;
  height: 2px;
  background: var(--wine);
  border-radius: 2px;
  transition: transform 0.25s, opacity 0.25s;
}

.menu-toggle.active .bar-1 {
  transform: translateY(7px) rotate(45deg);
}

.menu-toggle.active .bar-2 {
  opacity: 0;
}

.menu-toggle.active .bar-3 {
  transform: translateY(-7px) rotate(-45deg);
}

/* Mobile Drawer Overlay */
.mobile-drawer {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(18, 5, 6, 0.65);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
  pointer-events: none;
}

.mobile-drawer.active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.mobile-drawer-inner {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: min(380px, 88vw);
  background: #fffaf3;
  padding: 24px 20px 32px;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  box-shadow: -10px 0 40px rgba(0, 0, 0, 0.3);
  transform: translateX(100%);
  transition: transform 0.32s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.mobile-drawer.active .mobile-drawer-inner {
  transform: translateX(0);
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16px;
  border-bottom: 1px solid rgba(185, 137, 63, 0.18);
}

.drawer-title {
  display: block;
  font: 700 20px / 1.1 var(--font-serif);
  color: var(--wine);
}

.drawer-city {
  display: block;
  font-size: 8.5px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #8c6e5e;
  margin-top: 3px;
  font-weight: 700;
}

.drawer-close {
  background: rgba(87, 16, 25, 0.06);
  border: none;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  color: var(--wine);
  font-size: 15px;
  display: grid;
  place-items: center;
  cursor: pointer;
}

.mobile-links {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 14px;
}

.mobile-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border-radius: 10px;
  text-decoration: none;
  transition: background 0.2s;
  min-height: 44px;
}

.mobile-link:hover,
.mobile-link:active {
  background: rgba(87, 16, 25, 0.05);
}

.mobile-link span {
  font-size: 11px;
  font-weight: 800;
  color: #b9893f;
  width: 20px;
}

.mobile-link b {
  font: 600 16px var(--font-serif);
  color: #3b221a;
}

.drawer-divider {
  height: 1px;
  background: rgba(185, 137, 63, 0.15);
  margin: 16px 0;
}

.drawer-contact-block {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.drawer-contact-title {
  font-size: 9px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #8c6e5e;
  font-weight: 800;
}

.drawer-contact-items {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.drawer-contact-item {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  color: #553e35;
  text-decoration: none;
  padding: 8px 10px;
  border-radius: 10px;
  transition: color 0.25s, background-color 0.25s, transform 0.25s;
}

.drawer-contact-item:hover,
.drawer-contact-item:active {
  color: var(--wine);
  background: rgba(87, 16, 25, 0.06);
  transform: translateX(4px);
}

.drawer-contact-item :global(svg) {
  color: #b9893f;
  transition: color 0.3s ease, transform 0.3s ease;
}

.drawer-contact-item:hover :global(svg),
.drawer-contact-item:active :global(svg) {
  color: var(--wine);
  transform: scale(1.2);
}

.drawer-footer-note {
  margin-top: auto;
  padding-top: 24px;
}

.drawer-blessing {
  font-family: var(--font-devanagari);
  font-size: 12px;
  color: #b28342;
  text-align: center;
}

@media (max-width: 1024px) {
  .links,
  .desktop-only {
    display: none;
  }
  .nav {
    grid-template-columns: 1fr auto;
  }
  .menu-toggle {
    display: flex;
  }
  .mobile-drawer {
    display: block;
  }
}

@media (max-width: 768px) {
  .nav-wrapper {
    top: 10px;
  }
  .nav {
    height: 58px;
    padding: 0 12px 0 16px;
    border-radius: 16px;
    width: calc(100vw - 20px);
  }
  .brand-title {
    font-size: 21px;
  }
  .brand-subtitle {
    display: none;
  }
}
</style>

<script>
  // Mobile drawer controls with body scroll lock
  const nav = document.getElementById('mainNav');
  const menuToggle = document.getElementById('menuToggle');
  const mobileDrawer = document.getElementById('mobileDrawer');
  const drawerClose = document.getElementById('drawerClose');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 30) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }
  }, { passive: true });

  function openDrawer() {
    mobileDrawer?.classList.add('active');
    menuToggle?.setAttribute('aria-expanded', 'true');
    menuToggle?.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    mobileDrawer?.classList.remove('active');
    menuToggle?.setAttribute('aria-expanded', 'false');
    menuToggle?.classList.remove('active');
    document.body.style.overflow = '';
  }

  menuToggle?.addEventListener('click', () => {
    if (mobileDrawer?.classList.contains('active')) {
      closeDrawer();
    } else {
      openDrawer();
    }
  });

  drawerClose?.addEventListener('click', closeDrawer);
  mobileDrawer?.addEventListener('click', (e) => {
    if (e.target === mobileDrawer) closeDrawer();
  });

  mobileLinks.forEach(link => {
    link.addEventListener('click', closeDrawer);
  });
</script>
