---
import { property } from '../data/property';
import { Star, Wifi, Snowflake, Users, MapPin } from 'lucide-astro';
---

<div class="mobile-trust-strip" aria-label="Key property assurances">
  <div class="container">
    <div class="trust-track">
      <div class="trust-badge">
        <div class="stars-icon">
          <Star size={13} fill="#dcb567" stroke="#dcb567" />
          <Star size={13} fill="#dcb567" stroke="#dcb567" />
          <Star size={13} fill="#dcb567" stroke="#dcb567" />
          <Star size={13} fill="#dcb567" stroke="#dcb567" />
          <Star size={13} fill="#dcb567" stroke="#dcb567" />
        </div>
        <span><strong>{property.googleRatingDisplay}</strong> Google Rating</span>
      </div>

      <div class="trust-divider"></div>

      <div class="trust-badge">
        <Wifi size={14} class="badge-icon" />
        <span>Free Wi‑Fi</span>
      </div>

      <div class="trust-divider"></div>

      <div class="trust-badge">
        <Snowflake size={14} class="badge-icon" />
        <span>Full AC Rooms</span>
      </div>

      <div class="trust-divider"></div>

      <div class="trust-badge">
        <Users size={14} class="badge-icon" />
        <span>Family Suites</span>
      </div>

      <div class="trust-divider"></div>

      <div class="trust-badge">
        <MapPin size={14} class="badge-icon" />
        <span>Prime Varanasi Access</span>
      </div>
    </div>
  </div>
</div>

<style>
.mobile-trust-strip {
  background: #fbf3e6;
  border-bottom: 1px solid rgba(185, 137, 63, 0.2);
  padding: 12px 0;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}

.mobile-trust-strip::-webkit-scrollbar {
  display: none;
}

.trust-track {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  width: max-content;
  margin: 0 auto;
  padding: 0 16px;
}

.trust-badge {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 11.5px;
  font-weight: 600;
  color: #55342a;
  white-space: nowrap;
}

.trust-badge strong {
  color: var(--wine);
}

.stars-icon {
  display: flex;
  gap: 2px;
}

:global(.badge-icon) {
  color: #b9893f;
  flex-shrink: 0;
}

.trust-divider {
  width: 1px;
  height: 14px;
  background: rgba(185, 137, 63, 0.3);
  flex-shrink: 0;
}

@media (max-width: 768px) {
  .trust-track {
    justify-content: flex-start;
  }
}
</style>
