---
import { property } from '../data/property';
import RoomCard from './RoomCard.astro';
---

<section class="section rooms-section" id="rooms">
  <div class="container">
    <div class="section-top reveal">
      <div class="section-heading-wrap">
        <div class="story-marker">Chapter 03 · Rest</div>
        <div class="eyebrow">The room is the reset</div>
        <h2>Sleep well tonight. Wake up ready for Kashi again tomorrow.</h2>
        <p class="lead">
          The rooms are not just inventory. They are the quiet chapter between the moments you came to Varanasi to experience — a place to cool down, rest, plan the next morning and go back out into the lanes.
        </p>
      </div>
      
      <div class="rooms-action">
        <button class="btn primary open-booking-btn" type="button">
          Check all availability ✦
        </button>
      </div>
    </div>

    <!-- Mobile Swipe Cue -->
    <div class="mobile-swipe-cue" aria-hidden="true">
      <span>Swipe to view all rooms</span>
      <span class="swipe-arrow">→</span>
    </div>

    <!-- Responsive Rooms Grid / Mobile Scroll Snap Slider -->
    <div class="rooms-slider-container">
      <div class="rooms-grid">
        {property.rooms.map((room, index) => (
          <div class="room-slide-item">
            <RoomCard room={room} index={index} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.rooms-section {
  padding-top: 80px;
  padding-bottom: 100px;
}

.section-heading-wrap {
  max-width: 760px;
}

.rooms-action {
  flex-shrink: 0;
}

.mobile-swipe-cue {
  display: none;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: #a47c43;
  font-weight: 700;
  margin-bottom: 12px;
}

.swipe-arrow {
  animation: nudgeRight 1.5s ease-in-out infinite;
}

@keyframes nudgeRight {
  0%, 100% {
    transform: translateX(0);
  }
  50% {
    transform: translateX(4px);
  }
}

.rooms-slider-container {
  width: 100%;
}

.rooms-grid {
  display: grid;
  grid-template-columns: 1.25fr 0.88fr 0.88fr;
  gap: 20px;
}

.room-slide-item {
  width: 100%;
}

@media (max-width: 1024px) {
  .rooms-grid {
    grid-template-columns: 1fr 1fr;
  }
  .rooms-grid :global(.room-slide-item:first-child) {
    grid-column: span 2;
  }
}

/* Mobile Scroll-Snap Swipeable Carousel: 360px - 768px */
@media (max-width: 768px) {
  .rooms-section {
    padding-top: 60px;
    padding-bottom: 70px;
  }
  .section-top {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .rooms-action {
    display: none;
  }
  .mobile-swipe-cue {
    display: flex;
  }

  .rooms-slider-container {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin-left: -5vw;
    margin-right: -5vw;
    padding-left: 5vw;
    padding-right: 5vw;
    padding-bottom: 14px;
  }

  .rooms-slider-container::-webkit-scrollbar {
    display: none;
  }

  .rooms-grid {
    display: flex;
    gap: 14px;
    width: max-content;
  }

  .rooms-grid :global(.room-slide-item:first-child) {
    grid-column: auto;
  }

  .room-slide-item {
    width: 86vw;
    max-width: 380px;
    flex-shrink: 0;
    scroll-snap-align: center;
  }
}
</style>
