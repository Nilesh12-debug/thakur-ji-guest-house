---
import { property } from '../data/property';
import RoomCard from './RoomCard.astro';
---

<section class="section rooms-section" id="rooms">
  <div class="container">
    <div class="section-top reveal">
      <div class="section-heading-wrap">
        <div class="story-marker">Chapter 03 · Rest</div>
        <div class="eyebrow">The room is the reset</div>
        <h2>Sleep well tonight. Wake up ready for Kashi again tomorrow.</h2>
        <p class="lead">
          The rooms are not just inventory. They are the quiet chapter between the moments you came to Varanasi to experience — a place to cool down, rest, plan the next morning and go back out into the lanes.
        </p>
      </div>
      
      <div class="rooms-action">
        <button class="btn primary open-booking-btn" type="button">
          Book your room ✦
        </button>
      </div>
    </div>

    <!-- 3 Real Editorial Room Cards -->
    <div class="rooms-grid">
      {property.rooms.map((room, index) => (
        <RoomCard room={room} index={index} />
      ))}
    </div>
  </div>
</section>

<style>
.rooms-section {
  background: transparent;
  padding-top: 100px;
  padding-bottom: 110px;
}

.section-heading-wrap {
  max-width: 780px;
}

.rooms-action {
  flex-shrink: 0;
}

.rooms-grid {
  display: grid;
  grid-template-columns: 1.25fr 0.88fr 0.88fr;
  gap: 20px;
  margin-top: 10px;
}

@media (max-width: 1100px) {
  .rooms-grid {
    grid-template-columns: 1fr 1fr;
  }
  .rooms-grid :global(.room-card:first-child) {
    grid-column: span 2;
    min-height: 560px;
  }
}

@media (max-width: 680px) {
  .section-top {
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .rooms-grid {
    grid-template-columns: 1fr;
  }
  .rooms-grid :global(.room-card:first-child) {
    grid-column: auto;
  }
}
</style>
