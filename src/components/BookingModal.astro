---
import { property } from '../data/property';
import { Calendar, Users, Phone, MessageCircle, X } from 'lucide-astro';
---

<div class="booking-modal-overlay" id="bookingModalOverlay" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="booking-modal" id="bookingModal">
    <!-- Drag Handle indicator for mobile bottom sheet -->
    <div class="sheet-drag-handle" aria-hidden="true"></div>

    <button type="button" class="modal-close" id="modalCloseBtn" aria-label="Close booking modal">
      <X size={20} />
    </button>
    
    <div class="modal-badge">Direct Guest House Booking</div>
    <h3 id="modalTitle" class="modal-heading">Enquire with Thakur Ji</h3>
    <p class="modal-sub">Tell us your dates and preferred room. We will confirm availability instantly on WhatsApp or phone.</p>

    <form id="modalBookingForm" class="modal-form">
      <div class="form-row-2">
        <div class="field">
          <label for="modalCheckin">Check in date</label>
          <input type="date" id="modalCheckin" name="checkIn" required />
        </div>
        <div class="field">
          <label for="modalCheckout">Check out date</label>
          <input type="date" id="modalCheckout" name="checkOut" required />
        </div>
      </div>

      <div class="field" style="margin-top: 12px;">
        <label for="modalRoomSelect">Select Room</label>
        <select id="modalRoomSelect" name="room">
          <option value="Deluxe Room (Couples / 2–3 Guests)">Deluxe Room — Signature comfort (2–3 Guests)</option>
          <option value="Premium Room (Quieter Stay / 2–3 Guests)">Premium Room — Quieter sanctuary (2–3 Guests)</option>
          <option value="Family Room (Families & Groups / 4+ Guests)">Family Room — Multi-bed layout (4+ Guests)</option>
          <option value="Flexible / Any Available">Flexible / Any Available</option>
        </select>
      </div>

      <div class="field" style="margin-top: 12px;">
        <label for="modalGuests">Number of guests</label>
        <select id="modalGuests" name="guests">
          <option value="2 Adults">2 Adults · Couple / Friends</option>
          <option value="1 Adult (Solo)">1 Adult · Solo Traveller</option>
          <option value="2 Adults + 1 Child">2 Adults + 1 Child</option>
          <option value="3 Adults (Triple)">3 Adults · Triple Stay</option>
          <option value="4+ Adults (Family/Group)">4+ Adults · Family Group</option>
        </select>
      </div>

      <button type="submit" class="btn primary modal-submit-btn">
        <MessageCircle size={18} strokeWidth={2} />
        <span>Check Availability on WhatsApp ✦</span>
      </button>

      <div class="modal-phone-fallback">
        <span>Need immediate assistance?</span>
        <a href={`tel:${property.phone}`} class="modal-phone-link">
          <Phone size={15} />
          <span>Call Host: {property.phoneDisplay}</span>
        </a>
      </div>
    </form>
  </div>
</div>

<style>
.booking-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 10000;
  background: rgba(18, 5, 6, 0.72);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.booking-modal-overlay.active {
  opacity: 1;
  visibility: visible;
}

.booking-modal {
  width: min(540px, 94vw);
  background: #fffaf3;
  border: 1px solid rgba(224, 190, 115, 0.5);
  border-radius: 28px;
  padding: 34px;
  position: relative;
  box-shadow: 0 35px 90px rgba(0, 0, 0, 0.45);
  transform: translateY(20px) scale(0.97);
  transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  max-height: 90vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.booking-modal-overlay.active .booking-modal {
  transform: translateY(0) scale(1);
}

.sheet-drag-handle {
  display: none;
  width: 44px;
  height: 4px;
  border-radius: 99px;
  background: rgba(145, 101, 65, 0.25);
  margin: 0 auto 16px;
}

.modal-close {
  position: absolute;
  right: 20px;
  top: 20px;
  background: rgba(86, 16, 24, 0.08);
  border: none;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  cursor: pointer;
  display: grid;
  place-items: center;
  color: var(--wine);
  transition: background-color 0.25s, color 0.25s;
}

.modal-close:hover {
  background: var(--wine);
  color: #fff;
}

.modal-badge {
  font-size: 9px;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: #a3793f;
  font-weight: 800;
  margin-bottom: 6px;
}

.modal-heading {
  margin: 0 0 8px;
  font: 700 clamp(28px, 5vw, 36px) / 1.1 var(--font-serif);
  color: var(--wine);
  letter-spacing: -0.5px;
}

.modal-sub {
  font-size: 13px;
  line-height: 1.6;
  color: #725b52;
  margin: 0 0 20px;
}

.form-row-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.field label {
  display: block;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: #73584d;
  margin: 0 0 6px;
  font-weight: 700;
}

.field input,
.field select {
  width: 100%;
  padding: 13px;
  border: 1px solid #e7dbc8;
  border-radius: 12px;
  background: #ffffff;
  color: #4f3832;
  font-size: 14px;
  outline: none;
  min-height: 48px;
}

.field input:focus,
.field select:focus {
  border-color: #b9893f;
  box-shadow: 0 0 0 3px rgba(185, 137, 63, 0.15);
}

.modal-submit-btn {
  width: 100%;
  margin-top: 20px;
  min-height: 52px;
  font-size: 14px;
  border-radius: 14px;
}

.modal-phone-fallback {
  margin-top: 18px;
  text-align: center;
  font-size: 12px;
  color: #8c7368;
  display: flex;
  flex-direction: column;
  gap: 6px;
  align-items: center;
}

.modal-phone-link {
  font-weight: 700;
  color: var(--wine);
  font-size: 13.5px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 8px;
  transition: background 0.2s;
}

.modal-phone-link:hover {
  background: rgba(87, 16, 25, 0.08);
}

/* Mobile Bottom Sheet Transformation (<= 680px) */
@media (max-width: 680px) {
  .booking-modal-overlay {
    align-items: flex-end;
    padding: 0;
  }
  .booking-modal {
    width: 100vw;
    border-radius: 28px 28px 0 0;
    padding: 24px 20px calc(24px + env(safe-area-inset-bottom, 0px));
    transform: translateY(100%);
    max-height: 85vh;
  }
  .booking-modal-overlay.active .booking-modal {
    transform: translateY(0);
  }
  .sheet-drag-handle {
    display: block;
  }
  .modal-close {
    top: 18px;
    right: 18px;
  }
  .form-row-2 {
    grid-template-columns: 1fr;
  }
  .modal-heading {
    font-size: 26px;
  }
}
</style>

<script>
  // Modal & Bottom Sheet Controller
  const overlay = document.getElementById('bookingModalOverlay');
  const closeBtn = document.getElementById('modalCloseBtn');
  const modalForm = document.getElementById('modalBookingForm');
  const modalCheckin = document.getElementById('modalCheckin') as HTMLInputElement | null;
  const modalCheckout = document.getElementById('modalCheckout') as HTMLInputElement | null;

  if (modalCheckin && modalCheckout) {
    const today = new Date();
    const tomorrow = new Date(today);
    tomorrow.setDate(today.getDate() + 1);
    const dayAfter = new Date(today);
    dayAfter.setDate(today.getDate() + 2);

    const formatDate = (d: Date) => d.toISOString().split('T')[0];
    modalCheckin.min = formatDate(today);
    modalCheckin.value = formatDate(tomorrow);
    modalCheckout.min = formatDate(tomorrow);
    modalCheckout.value = formatDate(dayAfter);
  }

  function openModal(defaultRoom = "") {
    if (defaultRoom) {
      const roomSelect = document.getElementById('modalRoomSelect') as HTMLSelectElement | null;
      if (roomSelect) {
        for (let i = 0; i < roomSelect.options.length; i++) {
          if (roomSelect.options[i].text.toLowerCase().includes(defaultRoom.toLowerCase())) {
            roomSelect.selectedIndex = i;
            break;
          }
        }
      }
    }
    overlay?.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    overlay?.classList.remove('active');
    document.body.style.overflow = '';
  }

  closeBtn?.addEventListener('click', closeModal);
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeModal();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay?.classList.contains('active')) {
      closeModal();
    }
  });

  // Attach open handler to all elements with class .open-booking-btn
  document.querySelectorAll('.open-booking-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const targetRoom = (btn as HTMLElement).dataset.room || "";
      openModal(targetRoom);
    });
  });

  // Handle Enquiry submission -> WhatsApp
  modalForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const checkIn = (document.getElementById('modalCheckin') as HTMLInputElement)?.value || '';
    const checkOut = (document.getElementById('modalCheckout') as HTMLInputElement)?.value || '';
    const room = (document.getElementById('modalRoomSelect') as HTMLSelectElement)?.value || '';
    const guests = (document.getElementById('modalGuests') as HTMLSelectElement)?.value || '';

    const message = `Hello Thakur Ji Guest House! I want to book a stay in Varanasi:\n- Check-in: ${checkIn}\n- Check-out: ${checkOut}\n- Room Preference: ${room}\n- Guests: ${guests}\n\nPlease confirm availability and rates. Thank you!`;
    const whatsappUrl = `https://wa.me/919876543210?text=${encodeURIComponent(message)}`;
    window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
    closeModal();
  });
</script>
