---
import { property } from '../data/property';
import { Calendar, MessageCircle, Phone } from 'lucide-astro';
---

<section class="closing-story" id="book" style="--closing-image: url('/images/deluxe-room.webp'), url('/images/deluxe-room.jpg');">
  <div class="closing-overlay"></div>
  
  <div class="inner reveal">
    <div class="story-marker dark">Final chapter · Your stay</div>
    
    <div class="closing-eyebrow">The end of the page, not the journey</div>
    
    <h2 class="closing-title">
      Come for Kashi.<br />
      <em>Stay for comfort.</em>
    </h2>

    <p class="closing-copy">
      Make Thakur Ji Guest House your quiet, dependable sanctuary between the moments you came to experience — the early morning boat ride, the evening aarti, the temple visit and the walk through old Kashi.
    </p>

    <!-- Stacked Full-Width CTAs on Mobile -->
    <div class="closing-actions">
      <button class="btn primary closing-cta-btn open-booking-btn" type="button">
        <Calendar size={18} strokeWidth={2} />
        <span>Book Your Stay ✦</span>
      </button>

      <a 
        href={`https://wa.me/${property.whatsapp}?text=Hello%20Thakur%20Ji%20Guest%20House!%20I%20would%20like%20to%20plan%20my%20stay%20in%20Varanasi.`} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn ghost closing-wa-btn"
      >
        <MessageCircle size={18} strokeWidth={2} />
        <span>WhatsApp Us</span>
      </a>

      <a href={`tel:${property.phone}`} class="btn ghost closing-call-btn">
        <Phone size={18} strokeWidth={2} />
        <span>Call Property: {property.phoneDisplay}</span>
      </a>
    </div>

    <div class="closing-devanagari" aria-label="Atithi Devo Bhava, Har Har Mahadev">
      अतिथि देवो भवः · हर हर महादेव
    </div>
  </div>
</section>

<style>
.closing-story {
  position: relative;
  min-height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
  background: #1d080a;
  color: #fff2dc;
  isolation: isolate;
  padding: 80px 0;
}

.closing-story::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: var(--closing-image);
  background-size: cover;
  background-position: center 40%;
  filter: saturate(0.75);
  transform: scale(1.03);
  z-index: 1;
}

.closing-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(20, 5, 7, 0.75) 0%, rgba(20, 5, 7, 0.88) 60%, rgba(29, 8, 10, 0.98) 100%);
  z-index: 2;
}

.inner {
  position: relative;
  z-index: 3;
  width: min(880px, 90vw);
  margin: 0 auto;
}

.closing-eyebrow {
  font-size: 9.5px;
  letter-spacing: 3.5px;
  text-transform: uppercase;
  color: #dfb968;
  margin-bottom: 14px;
  font-weight: 700;
}

.closing-title {
  font: 600 clamp(48px, 7vw, 100px) / 0.88 var(--font-serif);
  margin: 0;
  letter-spacing: -1.5px;
  color: #ffffff;
}

.closing-title em {
  font-style: italic;
  font-weight: 400;
  color: #edcf87;
}

.closing-copy {
  max-width: 660px;
  margin: 20px auto 32px;
  font-size: 15px;
  line-height: 1.8;
  color: #e4d1bf;
}

.closing-actions {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
}

.closing-cta-btn,
.closing-wa-btn,
.closing-call-btn {
  height: 52px;
  padding: 0 24px;
  font-size: 13.5px;
  border-radius: 999px;
}

.closing-devanagari {
  font-family: var(--font-devanagari);
  font-weight: 600;
  font-size: 19px;
  color: #e2bd6c;
  margin-top: 36px;
  letter-spacing: 1.5px;
}

@media (max-width: 680px) {
  .closing-story {
    padding: 60px 0;
    min-height: auto;
  }
  .closing-title {
    font-size: clamp(38px, 10.5vw, 54px);
    line-height: 0.92;
  }
  .closing-copy {
    font-size: 13.5px;
    margin: 16px auto 26px;
  }
  .closing-actions {
    flex-direction: column;
    width: 100%;
    gap: 10px;
  }
  .closing-cta-btn,
  .closing-wa-btn,
  .closing-call-btn {
    width: 100%;
    height: 52px;
  }
  .closing-devanagari {
    font-size: 15px;
    margin-top: 26px;
  }
}
</style>
