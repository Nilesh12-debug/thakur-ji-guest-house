---
import { property } from '../data/property';
---

<div class="rating-card reveal">
  <div class="story-marker dark">Chapter 05 · Trust</div>
  <div class="eyebrow" style="color: #dfbb6b;">Why the story works</div>
  
  <div class="rating-score-row">
    <div class="rating-num">{property.googleRatingDisplay}</div>
    <div class="rating-stars-wrap">
      <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
      <div class="rating-badge">Google Reviews Rating</div>
    </div>
  </div>

  <blockquote class="trust-quote">
    “I can see what the rooms are really like, I understand the kind of stay this is, and I can picture it fitting into my Varanasi trip.”
  </blockquote>

  <div class="review-note">
    {property.googleReviewCount ? (
      <span>Verified score based on {property.googleReviewCount} real guest reviews on Google.</span>
    ) : (
      <span>Independent feedback based on real guest stays. Verified review quotes and current live count can be updated anytime in property.ts.</span>
    )}
  </div>
</div>

<style>
.rating-card {
  background: #5a1018;
  color: #fff2df;
  border-radius: 32px;
  padding: 42px 38px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 30px 90px rgba(47, 23, 16, 0.16);
  isolation: isolate;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.rating-card::after {
  content: "";
  position: absolute;
  right: -140px;
  top: -140px;
  width: 320px;
  height: 320px;
  border-radius: 50%;
  border: 1px solid rgba(228, 190, 112, 0.18);
  box-shadow: 0 0 0 24px rgba(228, 190, 112, 0.05), 0 0 0 54px rgba(228, 190, 112, 0.03);
  pointer-events: none;
  z-index: -1;
}

.rating-score-row {
  display: flex;
  align-items: baseline;
  gap: 16px;
  margin: 12px 0 18px;
}

.rating-num {
  font: 600 clamp(72px, 8vw, 96px) / 1 var(--font-serif);
  color: #fae9c9;
  letter-spacing: -2px;
}

.rating-stars-wrap {
  display: flex;
  flex-direction: column;
}

.stars {
  color: #e7c170;
  letter-spacing: 4px;
  font-size: 20px;
  margin-bottom: 4px;
}

.rating-badge {
  font-size: 10px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #deba6f;
  font-weight: 700;
}

.trust-quote {
  font: 500 24px / 1.35 var(--font-serif);
  color: #fff4e2;
  margin: 0;
  padding: 0;
  font-style: italic;
  max-width: 520px;
}

.review-note {
  font-size: 11px;
  color: #ceb8a8;
  margin-top: 24px;
  line-height: 1.7;
  padding-top: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
}

@media (max-width: 680px) {
  .rating-card {
    padding: 30px 24px;
    border-radius: 24px;
  }
  .rating-num {
    font-size: 68px;
  }
  .trust-quote {
    font-size: 20px;
  }
}
</style>
