---
import { property } from '../data/property';
import GoogleReviewSummary from './GoogleReviewSummary.astro';
import { Landmark, Flame, Sunset, Train, Navigation } from 'lucide-astro';

const attractionIcons: Record<string, any> = {
  'kashi-vishwanath': Landmark,
  'dashashwamedh-ghat': Flame,
  'assi-ghat': Sunset,
  'varanasi-junction': Train
};
---

<section class="section kashi-sec" id="location">
  <div class="container">
    <div class="section-top reveal">
      <div class="kashi-header-copy">
        <div class="story-marker">Chapter 05 · The City</div>
        <div class="eyebrow">Stay close to the experience</div>
        <h2>People remember the city. Your guest house becomes part of that memory.</h2>
        <div class="kashi-devanagari">सुबह गंगा के नाम · शाम सुकून के नाम</div>
        <p class="lead">
          We offer the reassurance of a reliable, comfortable sanctuary to return to while you immerse yourself in the living spiritual rhythm of Varanasi.
        </p>

        <!-- Single Elegant Location Action -->
        <div class="location-actions">
          <a 
            href={property.mapUrl || "https://maps.google.com/?q=Thakur+Ji+Guest+House+Varanasi"} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn primary map-main-btn"
          >
            <Navigation size={17} />
            <span>Find Us in Varanasi ↗</span>
          </a>
        </div>
      </div>
    </div>

    <div class="kashi-grid">
      <!-- Left: Google Reviews & Trust Card -->
      <GoogleReviewSummary />

      <!-- Right: Real Varanasi Landmarks with Lucide Icons -->
      <div class="attractions-grid">
        {property.attractions.map((place) => {
          const IconComp = attractionIcons[place.id] || Landmark;
          return (
            <article class="place-card reveal">
              <div class="place-header">
                <div class="place-badge-row">
                  <span class="place-badge">
                    {place.distance || place.walkingTime ? (
                      <span>{place.distance || place.walkingTime}</span>
                    ) : (
                      <span>Close to the Experience</span>
                    )}
                  </span>
                </div>
                <h3 class="place-name">{place.name}</h3>
              </div>
              
              <p class="place-desc">{place.description}</p>
              
              <div class="place-icon-bg" aria-hidden="true">
                <IconComp size={44} strokeWidth={1.3} />
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
.kashi-sec {
  background: #f0e4d4;
  padding-top: 90px;
  padding-bottom: 110px;
}

.kashi-header-copy {
  max-width: 820px;
}

.kashi-devanagari {
  font-family: var(--font-devanagari);
  font-weight: 600;
  font-size: 20px;
  color: #a06e30;
  margin: 10px 0 14px;
  letter-spacing: 0.5px;
}

.location-actions {
  display: flex;
  margin-top: 24px;
}

.map-main-btn {
  height: 48px;
  padding: 0 24px;
  font-size: 13px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.kashi-grid {
  display: grid;
  grid-template-columns: 0.95fr 1.05fr;
  gap: 28px;
  margin-top: 32px;
}

.attractions-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.place-card {
  background: #fffaf3;
  border: 1px solid rgba(145, 101, 65, 0.16);
  border-radius: 22px;
  padding: 24px;
  min-height: 180px;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
              box-shadow 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
              border-color 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.03);
}

.place-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 36px rgba(47, 23, 16, 0.09);
  border-color: rgba(185, 137, 63, 0.45);
}

.place-header {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 10px;
}

.place-name {
  margin: 0;
  font: 600 22px / 1.15 var(--font-serif);
  color: #5f1117;
  letter-spacing: -0.3px;
  transition: color 0.3s ease;
}

.place-card:hover .place-name {
  color: #7d1822;
}

.place-badge {
  font-size: 8.5px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: #a47b3e;
  font-weight: 700;
  transition: color 0.3s ease;
}

.place-card:hover .place-badge {
  color: var(--wine);
}

.place-desc {
  margin: 0;
  font-size: 11.5px;
  line-height: 1.65;
  color: #725b52;
  position: relative;
  z-index: 2;
  max-width: 86%;
}

.place-icon-bg {
  position: absolute;
  right: 16px;
  bottom: 14px;
  color: #c7984f;
  opacity: 0.22;
  pointer-events: none;
  transition: color 0.4s ease, transform 0.4s ease, opacity 0.4s ease, filter 0.4s ease;
}

.place-card:hover .place-icon-bg {
  transform: scale(1.18) rotate(5deg);
  opacity: 0.48;
  color: #a1232e;
  filter: drop-shadow(0 0 12px rgba(223, 186, 105, 0.6));
}

@media (max-width: 1024px) {
  .kashi-grid {
    grid-template-columns: 1fr;
    gap: 28px;
  }
}

@media (max-width: 680px) {
  .kashi-sec {
    padding-top: 60px;
    padding-bottom: 70px;
  }
  .location-actions {
    width: 100%;
  }
  .map-main-btn {
    width: 100%;
    justify-content: center;
    height: 50px;
  }
  .attractions-grid {
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .kashi-devanagari {
    font-size: 17px;
  }
  .place-card {
    min-height: auto;
    padding: 20px;
  }
  .place-card:active {
    transform: scale(0.97);
  }
  .place-card:active .place-icon-bg {
    opacity: 0.45;
    color: var(--wine);
  }
}
</style>
