---
import { property } from '../data/property';
import { MessageCircle } from 'lucide-astro';
---

<a 
  href={`https://wa.me/${property.whatsapp}?text=Hello%20Thakur%20Ji%20Guest%20House!%20I%20would%20like%20to%20enquire%20about%20room%20availability%20in%20Varanasi.`} 
  target="_blank" 
  rel="noopener noreferrer" 
  class="float-btn" 
  aria-label="Direct WhatsApp Enquiry"
  title="Chat with Thakur Ji Guest House on WhatsApp"
>
  <span class="float-icon">
    <MessageCircle size={26} strokeWidth={2.2} />
  </span>
  <span class="float-pulse"></span>
</a>

<style>
.float-btn {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 800;
  width: 58px;
  height: 58px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #5e1018;
  color: #f1c76f;
  border: 1.5px solid #c6974c;
  box-shadow: 0 16px 36px rgba(60, 16, 20, 0.35);
  animation: floatDiya 3.2s ease-in-out infinite;
  text-decoration: none;
  transition: transform 0.25s, box-shadow 0.25s;
}

.float-btn:hover {
  transform: scale(1.1) translateY(-4px);
  box-shadow: 0 20px 44px rgba(60, 16, 20, 0.45);
}

.float-icon {
  font-size: 24px;
  line-height: 1;
}

.float-pulse {
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  border: 2px solid #ebc775;
  opacity: 0.6;
  animation: pulseDiya 2.4s ease-out infinite;
}

@keyframes floatDiya {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8px);
  }
}

@keyframes pulseDiya {
  0% {
    transform: scale(0.95);
    opacity: 0.8;
  }
  100% {
    transform: scale(1.35);
    opacity: 0;
  }
}

@media (max-width: 680px) {
  .float-btn {
    right: 18px;
    bottom: 18px;
    width: 52px;
    height: 52px;
  }
  .float-icon {
    font-size: 22px;
  }
}
</style>
